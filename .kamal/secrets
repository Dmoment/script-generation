# Kamal secrets — values are read from .env.kamal (git-ignored).
# Safe to commit: no raw credentials here.

KAMAL_REGISTRY_PASSWORD=$(grep '^KAMAL_REGISTRY_PASSWORD=' .env.kamal | cut -d '=' -f2-)
RAILS_MASTER_KEY=$(grep '^RAILS_MASTER_KEY=' .env.kamal | cut -d '=' -f2-)

POSTGRES_PASSWORD=$(grep '^POSTGRES_PASSWORD=' .env.kamal | cut -d '=' -f2-)
DATABASE_URL="postgres://script_generation:$(grep '^POSTGRES_PASSWORD=' .env.kamal | cut -d '=' -f2-)@script-generation-db:5432/script_generation_production"

# Optional: only needed if the server-side OmniAuth flow is used
AUTH0_CLIENT_SECRET=$(grep '^AUTH0_CLIENT_SECRET=' .env.kamal | cut -d '=' -f2-)

AWS_ACCESS_KEY_ID=$(grep '^AWS_ACCESS_KEY_ID=' .env.kamal | cut -d '=' -f2-)
AWS_SECRET_ACCESS_KEY=$(grep '^AWS_SECRET_ACCESS_KEY=' .env.kamal | cut -d '=' -f2-)
