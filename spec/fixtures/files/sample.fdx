<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="5">
  <Content>
    <Paragraph Type="Action">
      <Text>FADE IN:</Text>
    </Paragraph>
    <Paragraph Number="1" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="1" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. KITCHEN - NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A kettle screams. </Text>
      <Text Style="Bold">Nobody</Text>
      <Text> moves.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MRS. FONSECA (V.O.) (CONT'D)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(flat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Not again.</Text>
    </Paragraph>
    <Paragraph Type="Shot">
      <Text>CLOSE ON THE KETTLE</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>SMASH CUT TO:</Text>
    </Paragraph>
    <Paragraph Number="2" StartsNewPage="Yes" Type="Scene Heading">
      <Text>EXT. PIER - DAWN</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Gulls. Fog. A sign.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" DualDialogue="Left">
      <Text>ignored dual marker</Text>
    </Paragraph>
    <Paragraph Alignment="Center" Type="General">
      <Text>THE END</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text></Text>
    </Paragraph>
  </Content>
  <TitlePage>
    <HeaderAndFooter FooterFirstPage="Yes" FooterVisible="No" HeaderFirstPage="No" HeaderVisible="Yes" StartingPage="1">
      <Header><Paragraph Alignment="Right"><Text>Page</Text></Paragraph></Header>
      <Footer><Paragraph><Text></Text></Paragraph></Footer>
    </HeaderAndFooter>
    <Content>
      <Paragraph Alignment="Center"><Text>THE KETTLE</Text></Paragraph>
      <Paragraph Alignment="Center"><Text>Written by</Text></Paragraph>
      <Paragraph Alignment="Center"><Text>A. Writer</Text></Paragraph>
    </Content>
  </TitlePage>
  <ElementSettings Type="Action"><FontSpec AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" Size="12" Style=""/></ElementSettings>
</FinalDraft>
